@model Humans.Web.ViewComponents.AdminSidebarViewModel

@* KFF fork: the main menu folds the groups (AdminMenu); hovering or focusing a top item opens its
   panel of groups, and each group's items are the tab strip on its pages. Below 768px the panels
   flatten into the horizontally scrolling strip of group rows. *@
<div class="sidebar-rows-wrap">
    <nav class="sidebar-rows" aria-label="Admin sections">
        @if (Model.ShowDashboard)
        {
            <a class="@(string.Equals(ViewContext.RouteData.Values["controller"] as string, AdminNavComposition.DashboardController, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
               asp-controller="@AdminNavComposition.DashboardController" asp-action="Index">
                <i class="fa-solid fa-house" aria-hidden="true"></i>
                <span>Dashboard</span>
            </a>
        }
        @foreach (var menu in Model.Menus)
        {
            <div class="menu">
                <a class="top@(menu.IsActive ? " on" : null)" href="@(menu.First.RawHref ?? Url.Action(menu.First.Action, menu.First.Controller))" aria-haspopup="true">
                    <i class="@menu.IconCssClass" aria-hidden="true"></i>
                    <span>@menu.Label</span>
                    @if (menu.PillSum.HasValue)
                    {
                        <span class="pill">@menu.PillSum.Value</span>
                    }
                    <i class="fa-solid fa-chevron-right chev" aria-hidden="true"></i>
                </a>
                <div class="subnav" role="group" aria-label="@menu.Label">
                    <div class="sub-head"><b>@menu.Label</b><small>@menu.Description</small></div>
                    @foreach (var group in menu.Groups)
                    {
                        <partial name="~/Views/Shared/Components/AdminSidebar/_AdminSidebarGroupRow.cshtml" model="group" />
                    }
                </div>
            </div>
        }
        @if (Model.Foot is { } foot)
        {
            <div class="foot">
                <partial name="~/Views/Shared/Components/AdminSidebar/_AdminSidebarGroupRow.cshtml" model="foot" />
            </div>
        }
    </nav>
</div>
